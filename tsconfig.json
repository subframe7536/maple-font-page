{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@data/*": [
        "./data/*"
      ]
    },
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "solid-file-router/client",
      "node"
    ],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "data",
    "vite.config.ts",
    "intlayer.config.ts",
    "uno.config.ts",
    ".intlayer/types/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
