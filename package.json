{
  "name": "maple-font-page",
  "type": "module",
  "version": "7.9.5",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build && node build/static.ts",
    "preview": "vite preview --outDir dist/client --host",
    "check": "tsc --noEmit",
    "format": "eslint --fix --cache",
    "release": "pnpm run check && pnpm run build && bumpp --all",
    "lint": "eslint .",
    "test:ssg": "node --test tests/ssg.test.mjs"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-solid": "^8.6.0",
    "intlayer": "^9.6.0",
    "moraine": "0.6.0-beta.3",
    "solid-intlayer": "^9.6.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.53",
    "@solid-hooks/core": "^0.6.0",
    "@subf/unocss": "^0.4.0",
    "@subframe7536/eslint-config": "^1.3.1",
    "@subframe7536/fonttools": "^0.3.2",
    "@subframe7536/type-utils": "^0.2.0",
    "@types/node": "^24.0.0",
    "@unocss/preset-typography": "^66.10.5",
    "bumpp": "^10.2.0",
    "eslint": "^9.30.0",
    "eslint-plugin-solid": "^0.14.5",
    "satteri": "^0.9.5",
    "shiki": "^4.4.0",
    "solid-file-router": "^0.7.3",
    "typescript": "~5.9.3",
    "unocss-preset-animations": "^1.2.1",
    "vite": "^8.0.0",
    "vite-intlayer": "^9.6.0",
    "vite-plugin-solid": "^2.11.0",
    "yaml": "^2.9.1"
  }
}
