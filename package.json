{
  "name": "maple-font-page",
  "version": "7.9.5",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build && node build/static.ts",
    "preview": "vite preview --outDir dist/client --host",
    "check": "tsc --noEmit",
    "format": "oxfmt",
    "release": "pnpm run check && pnpm run build && bumpp --all",
    "lint": "oxlint --max-warnings 0 --report-unused-disable-directives",
    "test:ssg": "node --test tests/ssg.test.mjs",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-solid": "^8.6.0",
    "intlayer": "^9.6.0",
    "moraine": "0.6.0-beta.3",
    "solid-intlayer": "^9.6.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.53",
    "@subf/config": "^0.5.0",
    "@subf/unocss": "^0.4.0",
    "@subframe7536/fonttools": "^0.3.2",
    "@types/node": "^24.0.0",
    "@unocss/preset-typography": "^66.10.5",
    "bumpp": "^12.3.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "satteri": "^0.9.5",
    "shiki": "^4.4.0",
    "solid-file-router": "^0.7.3",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vite-intlayer": "^9.6.0",
    "vite-plugin-solid": "^2.11.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.25.0"
}
